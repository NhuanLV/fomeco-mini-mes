{
  "compilerOptions": {
    "paths": { "@/*": ["./webapp/src/*"], "#build/ui": ["./node_modules/.nuxt-ui/ui"] },
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noUnusedLocals": true
  },
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "webapp/src/**/*", "webapp/src/**/*.vue", "webapp/auto-imports.d.ts", "webapp/components.d.ts"]
}
